# ---- Build artifacts: embeddings, indexes, data dumps -----------------------
# Note: `data/*` not `data/` - git cannot re-include a file whose parent
# directory is excluded, so the negation below only works with the glob.
data/*
!data/.gitkeep
!data/inspection_report.md
!data/model_benchmark.json
!data/bm25_diagnostic.json
!data/truncation_probe.json
!data/truncation_probe_test.json
!data/corpus_variants.json
!data/rerank_train_dev.json
!data/rerank_train_dev_bge.json
!data/corpus_variants_test.json
!data/cache_rebuild_demo.json
!data/cleanup_report.md
*.faiss
*.index
*.npy
*.npz
*.pkl
*.pickle

# ---- Evaluation output ------------------------------------------------------
results/
predictions/
# NOTE: appsretrieval_results.json is the graded deliverable and IS committed.
# Keep it tracked so every score is traceable to a commit.

